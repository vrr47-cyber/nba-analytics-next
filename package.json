{
  "name": "nba-analytics-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm run frontend:dev",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:test": "pnpm --dir frontend test",
    "frontend:lint": "pnpm --dir frontend lint",
    "frontend:typecheck": "pnpm --dir frontend typecheck",
    "build": "pnpm run frontend:build",
    "test": "pnpm run backend:test && pnpm run frontend:test",
    "lint": "pnpm run backend:lint && pnpm run frontend:lint",
    "typecheck": "pnpm run backend:typecheck && pnpm run frontend:typecheck",
    "backend:dev": "python3 -m uvicorn backend.app.main:create_app --factory --reload --host 0.0.0.0 --port 8000",
    "backend:test": "python3 -m pytest backend/tests",
    "backend:lint": "python3 -m ruff check backend",
    "backend:typecheck": "python3 -m mypy backend/app",
    "db:migrate": "python3 -m alembic -c backend/alembic.ini upgrade head",
    "db:downgrade": "python3 -m alembic -c backend/alembic.ini downgrade -1",
    "teams:ingest": "python3 -m backend.app.jobs.ingest_teams",
    "players:rosters:ingest": "python3 -m backend.app.jobs.ingest_players_rosters",
    "api:openapi": "python3 -m backend.app.openapi > backend/openapi.json",
    "api:check": "python3 scripts/check_openapi.py",
    "repo:check": "python3 scripts/check_repository_hygiene.py"
  },
  "workspaces": ["frontend"]
}
